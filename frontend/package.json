{
  "name": "avp-tutor-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --project=ci",
    "test:e2e:ui": "playwright test --ui",
    "deploy:gh-pages": "VITE_BASE_PATH=/avp-tutor/ vite build && npx gh-pages -d dist",
    "generate:types": "openapi-typescript ../integrations/openapi.json -o ../integrations/schema.d.ts",
    "format": "prettier --write src e2e ../integrations/tutor-client.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "gh-pages": "^6.3.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.8",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=22"
  }
}
