# Local inference by default. Pull this model with Ollama before starting.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=700
# Opt-in only: setting a hosted fallback can send code/state to that provider.
LLM_FALLBACK_PROVIDER=

# For hosted comparison, set LLM_PROVIDER=openai or anthropic and configure
# BOTH the key and an exact model ID available to your account.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional OpenAI-compatible local server
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=local-model
VLLM_API_KEY=local

# Lexical mode has no model downloads. semantic requires uv sync --extra semantic.
RETRIEVAL_BACKEND=lexical
EMBEDDING_DEVICE=cpu
# Comma-separated origins for a separately hosted visualizer frontend.
CORS_ORIGINS=
# Only direct, trusted reverse-proxy IPs may supply X-Real-IP.
TRUSTED_PROXY_IPS=

# Google AI Studio / Gemini API (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=
# GOOGLE_API_KEY is accepted as an alternative key variable.

# Optional research capture: requires per-request feedback_consent=true as well.
FEEDBACK_ENABLED=false
# FEEDBACK_DB_PATH=/absolute/private/path/feedback.sqlite3
# HARNESS_CONFIG=/absolute/path/to/reviewed-harness.json
